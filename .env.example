# 复制为 .env 后按需修改。勿将真实 .env 提交到 Git（密钥与 venv 永不入库）。
# cp .env.example .env

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=qc_platform
MYSQL_USER=qc_user
MYSQL_PASSWORD=change_me_user
MYSQL_HOST=db
MYSQL_PORT=3306

# SQLAlchemy 连接串（与上面账号库名一致；密码含特殊字符时请 URL 编码）
DATABASE_URL=mysql+pymysql://qc_user:change_me_user@db:3306/qc_platform

# ---- API ----
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# 规则集版本号（占位；业务实现后由后端读取）
RULES_VERSION=v1

# ---- Redis 缓存 ----
# 容器内主机名用 compose 服务名 redis；本机直跑时改成 127.0.0.1
REDIS_URL=redis://redis:6379/0
# 映射到宿主机的端口（宿主机 6379 被占时改这个，不影容器间通信）
REDIS_HOST_PORT=6379
# 报告缓存的存活秒数（TTL 只是兜底，真正的一致性靠 create_run 里主动删）
REPORT_CACHE_TTL=600
